{
  "name": "burako-lan-server",
  "version": "2.3.0",
  "description": "Servidor autoritativo para jugar Burako multijugador en red local (LAN)",
  "main": "server.js",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "start": "node server.js",
    "test:supabase": "node scripts/test-supabase-connection.mjs",
    "db:push": "supabase db push",
    "db:migration:new": "supabase migration new",
    "migrate:players": "node scripts/migrate-players-to-supabase.mjs",
    "validate:migration": "node scripts/validate-migration.mjs",
