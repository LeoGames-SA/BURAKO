# Copiá este archivo a ".env" en la misma carpeta y completá los valores reales.
# ".env" NUNCA se sube al repo (ver .gitignore) — cada entorno (tu máquina, Render)
# tiene el suyo propio.

# Panel de Supabase → Project Settings → API
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Panel de Supabase → Project Settings → API → "service_role" (secreta — NUNCA
# la clave "anon"/pública acá, y esta clave nunca debe llegar al cliente/APK).
SUPABASE_SERVICE_ROLE_KEY=

# Personal Access Token de tu cuenta (no del proyecto) — solo hace falta para
# correr comandos de la CLI (migraciones, link, db push), el servidor en sí
# (server.js) no lo usa en tiempo de ejecución.
# Generar en: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Puerto donde escucha el servidor Node. En Render se define solo (no hace falta
# tocarlo); en local, 8181 si no se especifica otra cosa.
PORT=8181
